# Exclude these from the Docker build context

# Dependencies (will be installed fresh in container)
node_modules
.pnpm-store

# Build outputs
.next
out
dist

# Development files
.git
.gitignore
*.md
*.log

# IDE
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage

# Environment files (passed separately)
.env*.local
