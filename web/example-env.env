# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://assets.vidbolt.app
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.vidbolt.app

# GPU API (local backend)
GPU_API_URL=http://localhost:8000
GPU_API_KEY=

# GPU Webhook Configuration
GPU_WEBHOOK_SECRET=
WEBHOOK_CALLBACK_URL=

# Internal API Secret (used by BullMQ workers to call secured API routes)
INTERNAL_API_SECRET=

# Required if your repo is private
VIDBOLT_GITHUB_TOKEN=ghp_your_secure_token...

# Optional (defaults to https://github.com/OBress/Vid-Bolt-GPU-API.git)
VIDBOLT_REPO_URL=https://github.com/OBress/Vid-Bolt-GPU-API.git

# GCP Account Project for refreshing OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pexel API key
PEXELS_API_KEY=

# Serper API Key
SERPER_API_KEY=

# Valyu research
VALYU_API_KEY=

# Map box
MAPBOX_API_TOKEN=

# AWS (for Remotion Lambda rendering)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Remotion Lambda (values output by: npx tsx scripts/deploy-lambda.ts)
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_S3_BUCKET=

# Freesound API (free SFX library - https://freesound.org/apiv2/apply/)
FREESOUND_API_KEY=

# Stripe (GPU hours purchasing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Data Retention (days after video created_at before cleanup, default: 20)
DATA_RETENTION_DAYS=20