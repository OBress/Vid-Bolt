# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# inngest
INNGEST_DEV=true
INNGEST_EVENT_KEY=key
INNGEST_SIGNING_KEY=secret

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=

# GPU API (local backend)
GPU_API_URL=http://localhost:8000
GPU_API_KEY=

# GPU Webhook Configuration
GPU_WEBHOOK_SECRET=
WEBHOOK_CALLBACK_URL=

# Required if your repo is private
VIDBOLT_GITHUB_TOKEN=ghp_your_secure_token...

# Optional (defaults to https://github.com/OBress/Vid-Bolt-GPU-API.git)
VIDBOLT_REPO_URL=https://github.com/OBress/Vid-Bolt-GPU-API.git

# Required for the integration to know which project to target
NEXT_PUBLIC_GCP_PROJECT_ID=your-gcp-project-id


GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_SEARCH_ENGINE_ID=

# Serper (Google Search API)
SERPER_API_KEY=

# Valyu research
VALYU_API_KEY=

# Map box
MAPBOX_API_TOKEN=